{
  "name": "selfblog-desktop",
  "version": "1.0.0",
  "description": "SelfBlog 个人博客系统 · 桌面版（Electron 壳）",
  "main": "main.js",
  "author": "SelfBlog",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "sync:web": "robocopy ..\\web\\dist renderer /E /NFL /NDL /NJH /NJS /NP & exit 0",
    "predist": "npm run sync:web",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.selfblog.desktop",
    "productName": "SelfBlog",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SelfBlog"
    }
  }
}
